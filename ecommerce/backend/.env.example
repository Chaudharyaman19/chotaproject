NODE_ENV=development
PORT=5000
LOG_LEVEL=info

MONGODB_URI=mongodb://127.0.0.1:27017/shopeasy
REDIS_URL=redis://127.0.0.1:6379

# Comma-separated allowed browser origins
FRONTEND_URL=http://localhost:3000

# Must be >= 32 chars. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-32chars+

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong
